# ---------------------------------------------------------------------------
# Wireup environment configuration
# Copy to `.env` and fill in. NOTHING here is hardcoded in the application.
# ---------------------------------------------------------------------------

# --- MongoDB ---------------------------------------------------------------
# Any standard MongoDB connection string (local, Atlas, docker…).
# If MONGODB_URI is EMPTY/UNSET, Wireup runs on an in-process store so `pnpm
# dev` works with zero services — projects are then LOST ON RESTART, and every
# project states that in its first event. Force a side with true/false.
WIREUP_IN_MEMORY_STORE="auto"
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB="wireup"

# --- Amazon Bedrock --------------------------------------------------------
# Region that hosts the model you configured below.
AWS_REGION="us-east-1"
# Static credentials. If omitted, the AWS SDK default credential chain is used
# (IAM role / profile / etc). Credentials are NEVER hardcoded in source.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Optional, only for temporary credentials.
AWS_SESSION_TOKEN=""

# Fully qualified Bedrock model ids (base model or inference/profile ARN).
BEDROCK_MODEL_ID="anthropic.claude-3-5-sonnet-20240620-v1:0"
BEDROCK_VALIDATION_MODEL_ID=""
BEDROCK_FIXER_MODEL_ID=""
# Optional per-role override for AI-first firmware authoring (the rooted
# codegen stage). Falls back to BEDROCK_MODEL_ID when empty.
BEDROCK_CODEGEN_MODEL_ID=""

# Inference configuration
BEDROCK_MAX_TOKENS="8000"
# Upper bound the structured caller may raise maxTokens to when a response comes
# back cut off (stopReason "max_tokens"), which makes the JSON unparseable.
# Keep at or below the model's own output cap — Kimi K2.5 allows 16k.
BEDROCK_MAX_TOKENS_CEILING="16000"
BEDROCK_TEMPERATURE="0.2"
BEDROCK_TOP_P="0.9"
BEDROCK_TIMEOUT_MS="120000"
BEDROCK_MAX_RETRIES="2"

# --- Idea graph ------------------------------------------------------------
# Recursive decomposition of the prompt into subsystems with per-node tests,
# a fresh-context reviewer and swarm-role assignments. When off, Everflow
# behaves exactly as before the idea graph existed.
WIREUP_ENABLE_IDEA_GRAPH="true"
# BACKSTOP on total expansions — tripping it files an ask and says so; it is
# never the normal way the graph finishes.
WIREUP_IDEA_GRAPH_MAX_EXPANSIONS="40"
# Targeted repairs per node before the ladder escalates to a human ask
# (default-on-expiry: defer).
WIREUP_IDEA_GRAPH_MAX_NODE_REPAIRS="2"
# Tier-2 mid-turn steering — only ever honoured when the configured model is
# gpt-6-astra; the default persisted (next-pass) path is always kept.
WIREUP_ENABLE_MID_TURN_STEER="false"
# Optional per-swarm-role model overrides (Bedrock model ids). Empty = the
# shared validation model, then the main model.
WIREUP_SWARM_ROLE_MODEL_HARDWARE=""
WIREUP_SWARM_ROLE_MODEL_FIRMWARE=""
WIREUP_SWARM_ROLE_MODEL_WEB=""
WIREUP_SWARM_ROLE_MODEL_MECHANICS=""

# --- Agent behaviour -------------------------------------------------------
# Maximum number of validate -> fix -> re-validate correction iterations.
WIREUP_MAX_FIX_ITERATIONS="3"
# Allow the fixer to ask the model for a targeted changeset when the
# deterministic fixers cannot resolve an issue.
WIREUP_ENABLE_LLM_FIXER="true"
# Run the critical model review as part of validation (in addition to rules).
WIREUP_ENABLE_LLM_VALIDATION="true"
# AI-first firmware authoring: the model writes the sketch's behavioural logic
# against the grounded pin plan, and the rooting gate assembles the final file
# with Wireup's machine-managed includes + pin map. Any rooting violation
# (invented pins, foreign includes, contract breaches) falls back to the
# deterministic template, so this is safe to leave on.
WIREUP_ENABLE_LLM_CODEGEN="true"
# Host compile gate: before a revision is frozen (generation, fix, workbench
# edit), the sketch is type-checked against the stub Arduino core with
# g++/clang++. Skipped honestly when no compiler is on PATH.
WIREUP_ENABLE_FIRMWARE_COMPILE="true"
# Seed the component catalog into MongoDB on first use if the collection is empty.
WIREUP_AUTOSEED_COMPONENTS="true"
# Cap on stored revisions / events per project document.
WIREUP_MAX_REVISIONS="12"
WIREUP_MAX_EVENTS="1500"
# Everflow: max continuation passes per trigger (the agent iterates on the
# project graph until goals are met, blocked on humans, or budget is spent).
WIREUP_EVERFLOW_MAX_PASSES="3"
# Everflow: cap on open human-channel tasks the agent will file at once.
# Extras stay parked (visible, counted) without creating more asks.
WIREUP_EVERFLOW_MAX_HUMAN_TASKS="12"
# Research tool: allow pulling a snippet from the cited documentation page
# (best-effort; the offline catalog + docs corpus always work, and web
# findings are flagged for human review).
WIREUP_ENABLE_WEB_DOCS="true"
WIREUP_WEB_DOCS_TIMEOUT_MS="4000"

# --- Networking ------------------------------------------------------------
# DNS resolution order for outbound AWS calls.
#   ipv4first (default) — prefer IPv4. Works around Windows/VPN/WSL/Docker
#                         resolvers that return EAI_AGAIN for the IPv6 (AAAA)
#                         half of a lookup, which otherwise makes a perfectly
#                         healthy Bedrock endpoint look unreachable.
#   verbatim            — Node's own default ordering.
#   ipv6first           — prefer IPv6, for hosts where that is the healthy path.
# An explicit NODE_OPTIONS=--dns-result-order=… always wins over this.
WIREUP_DNS_RESULT_ORDER="ipv4first"

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Wireup"
