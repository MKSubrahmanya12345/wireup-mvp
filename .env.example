# ---------------------------------------------------------------------------
# Wireup environment configuration
# Copy to `.env` and fill in. NOTHING here is hardcoded in the application.
# ---------------------------------------------------------------------------

# --- MongoDB ---------------------------------------------------------------
# Any standard MongoDB connection string (local, Atlas, docker…).
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB="wireup"

# --- Amazon Bedrock --------------------------------------------------------
# Region that hosts the model you configured below.
AWS_REGION="us-east-1"
# Static credentials. If omitted, the AWS SDK default credential chain is used
# (IAM role / profile / etc). Credentials are NEVER hardcoded in source.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Optional, only for temporary credentials.
AWS_SESSION_TOKEN=""

# Fully qualified Bedrock model ids (base model or inference/profile ARN).
BEDROCK_MODEL_ID="anthropic.claude-3-5-sonnet-20240620-v1:0"
BEDROCK_VALIDATION_MODEL_ID=""
BEDROCK_FIXER_MODEL_ID=""

# Inference configuration
BEDROCK_MAX_TOKENS="8000"
# Upper bound the structured caller may raise maxTokens to when a response comes
# back cut off (stopReason "max_tokens"), which makes the JSON unparseable.
# Keep at or below the model's own output cap — Kimi K2.5 allows 16k.
BEDROCK_MAX_TOKENS_CEILING="16000"
BEDROCK_TEMPERATURE="0.2"
BEDROCK_TOP_P="0.9"
BEDROCK_TIMEOUT_MS="120000"
BEDROCK_MAX_RETRIES="2"

# --- Agent behaviour -------------------------------------------------------
# Maximum number of validate -> fix -> re-validate correction iterations.
WIREUP_MAX_FIX_ITERATIONS="3"
# Allow the fixer to ask the model for a targeted changeset when the
# deterministic fixers cannot resolve an issue.
WIREUP_ENABLE_LLM_FIXER="true"
# Run the critical model review as part of validation (in addition to rules).
WIREUP_ENABLE_LLM_VALIDATION="true"
# Seed the component catalog into MongoDB on first use if the collection is empty.
WIREUP_AUTOSEED_COMPONENTS="true"
# Cap on stored revisions / events per project document.
WIREUP_MAX_REVISIONS="12"
WIREUP_MAX_EVENTS="1500"

# --- Networking ------------------------------------------------------------
# DNS resolution order for outbound AWS calls.
#   ipv4first (default) — prefer IPv4. Works around Windows/VPN/WSL/Docker
#                         resolvers that return EAI_AGAIN for the IPv6 (AAAA)
#                         half of a lookup, which otherwise makes a perfectly
#                         healthy Bedrock endpoint look unreachable.
#   verbatim            — Node's own default ordering.
#   ipv6first           — prefer IPv6, for hosts where that is the healthy path.
# An explicit NODE_OPTIONS=--dns-result-order=… always wins over this.
WIREUP_DNS_RESULT_ORDER="ipv4first"

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Wireup"
